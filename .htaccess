# When document root is the Laravel root (not `public/`), forward requests into
# `public/`. Root `index.php` also boots the app when "/" is served via DirectoryIndex
# (fixes Apache "Index of" when rewrite for an empty path is skipped).

<IfModule mod_rewrite.c>
    Options -Indexes +FollowSymLinks
    RewriteEngine On

    # ---- Force HTTPS ----
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Already under /public/ — stop (avoid public/public/...)
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # Homepage: boot via public front controller (same path as /shop)
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^index\.php$ public/index.php [L]

    # Real files at repo root (favicon, robots if present) — serve as-is
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else → public/ (assets + Laravel for /shop, /product/..., etc.)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

Options -Indexes
